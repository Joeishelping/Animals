{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "worldanimals:lobster",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": {
          "min": 7,
          "max": 15,
          "adjust_for_weather": false
        },
        "minecraft:weight": {
          "default": 4
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 2
        },
        "minecraft:density_limit": {
          "surface": 4,
          "underground": 0
        },
        "minecraft:biome_filter": {
          "all_of": [
            {
              "any_of": [
                {
                  "test": "has_biome_tag",
                  "operator": "==",
                  "value": "beach"
                },
                {
                  "test": "has_biome_tag",
                  "operator": "==",
                  "value": "stone_beach"
                }
              ]
            },
            {
              "test": "has_biome_tag",
              "operator": "!=",
              "value": "warm"
            }
          ]
        }
      }
    ]
  }
}
